{
  "name": "linkrrss",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
